# The API's configuration for local development. Copy this file to .env
# (git-ignored) and adjust it. Every variable is required: the API refuses
# to start if one is missing or invalid (ADR 0019, decision 2).

# Address to listen on. 127.0.0.1 keeps the API unreachable from the network.
HOST=127.0.0.1

# Port to listen on, 1-65535.
PORT=3000

# Least severe log level to write: fatal, error, warn, info, debug, trace or
# silent.
LOG_LEVEL=info

# The PostgreSQL database. These values match compose.yaml at the repository
# root; on AWS, the password comes from the RDS-managed secret (ADR 0020).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=szop
DATABASE_USER=szop
DATABASE_PASSWORD=szop

# TLS to the database: "none" or "verify-full". The local container has no
# TLS, so "none". On the demo, "verify-full": the API checks RDS's
# certificate against apps/api/certs/rds-global-bundle.pem and the server's
# name (ADR 0033).
DATABASE_TLS=none

# The built web app, which `pnpm build` writes to apps/web/dist. Relative
# paths are resolved against the folder the API starts in (apps/api through
# pnpm). If the folder does not exist yet, as in `pnpm dev`, the API logs a
# warning and serves its own routes only (ADR 0023).
WEB_ROOT=../web/dist

# The proxies in front of the API whose X-Forwarded-For entries are believed:
# "none", or a comma-separated list of IP addresses and CIDR ranges. Locally
# nothing sits in front of the API, so "none". In AWS, the load balancer's
# subnets (or, looser, the VPC's range). Never wider than that: whoever holds a
# trusted address can choose the client address the API logs and rate-limits
# (ADR 0025).
TRUSTED_PROXIES=none

# The commit the code was built from: 40 lowercase hex characters, or
# "unknown". The container image sets the real value when it is built; outside
# it, "unknown" (PH-12d spec, decision 3).
GIT_COMMIT=unknown

# Signs the session cookies: at least 32 characters. Any value works locally;
# the demo's comes from SSM, never from this file (ADR 0057).
BETTER_AUTH_SECRET=development-only-secret-change-me-0123456789

# The address the browser opens, with no path. Vite's in development; Better
# Auth trusts requests from this origin only, and an https one makes the
# session cookie Secure.
APP_ORIGIN=http://localhost:5173
