{
  "permissions": {
    "allow": [
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue create *)",
      "Bash(gh issue edit *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(gh pr * merge*)",
      "Bash(gh workflow * run*)",
      "Bash(gh run rerun*)",
      "Bash(gh run * rerun*)",
      "Bash(gh api *pending_deployments*)",
      "Bash(gh api *dispatches*)",
      "Bash(gh api *rulesets*)",
      "Bash(gh api *environments*)",
      "Bash(gh api *merge*)",
      "Bash(gh api graphql*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-push.ts"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-guard.ts search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-guard.ts read",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
