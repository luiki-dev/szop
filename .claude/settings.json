{
  "permissions": {
    "deny": [
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "Bash(git push -d*)",
      "Bash(git push * -d*)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-push.ts"
          }
        ]
      }
    ]
  }
}
