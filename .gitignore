# Terraform: local state (bootstrap starts with it, ADR 0008 decision 7), provider
# caches and variable files (ADR 0029)
*.tfstate*
.terraform/
*.tfvars
# Saved plans (terraform plan -out) hold every value of the configuration
*.tfplan

# Claude Code: personal settings and permissions
.claude/settings.local.json

# Superpowers brainstorming companion: mockups and session state
.superpowers/

# Dependencies installed by pnpm
node_modules/

# The web app's production build (pnpm build)
dist/

# Playwright's report and test output (pnpm test:e2e)
e2e/playwright-report/
e2e/test-results/

# Local configuration (copied from .env.example) and test coverage reports
.env
coverage/

# Stryker's report (pnpm test:mutation) and its sandbox copies
reports/
.stryker-tmp/
