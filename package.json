{
  "name": "szop",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12 <25"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @szop/api start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm test --coverage",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test:e2e": "pnpm build && pnpm --filter @szop/e2e exec playwright test",
    "test:e2e:report": "pnpm --filter @szop/e2e exec playwright show-report",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose stop",
    "db:reset": "docker compose down --volumes && docker compose up -d --wait",
    "image:up": "docker compose --profile app up --build",
    "image:down": "docker compose --profile app down",
    "check:image": "scripts/check-image.sh",
    "check:infra": "scripts/check-infra.sh",
    "check:workflows": "scripts/check-workflows.sh",
    "infra:fmt": "terraform fmt -recursive infra",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
